#!/bin/sh
set -eu
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
installed="$hook_dir/.capture-it-fluid/capture-it-fluid"
if [ -x "$installed" ]; then
    exec "$installed" "$@"
fi
binary="$hook_dir/fluid-audio/.build/release/capture-it-fluid"
if [ ! -x "$binary" ]; then
    echo 'FluidAudio hook is not installed or built. Run make setup-fluid explicitly first.' >&2
    exit 1
fi
exec "$binary" "$@"
